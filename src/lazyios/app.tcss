Screen {
    background: $background;
    color: $foreground;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
}

TabbedContent {
    height: 1fr;
}

TabbedContent > ContentTabs {
    height: 2;
}

Tabs {
    background: $background;
}

Tab {
    color: $text-muted;
    background: $background;
    padding: 0 2 0 1;
}

Tab.-active {
    color: $primary;
    background: $background;
    text-style: bold;
}

Tab:hover {
    color: $foreground;
}

Tabs .underline--bar {
    color: $primary;
    background: $panel;
}

TabPane {
    padding: 0;
}

TabPane > * {
    height: 1fr;
}

OverviewTab {
    overflow-y: auto;
    padding: 1 2;
}

.head {
    height: 1;
    color: $primary;
    text-style: bold;
    padding: 0 1;
}

.notice {
    height: auto;
    padding: 0 1;
}

Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
}

Input:focus {
    border: none;
    background: #1c1c19;
}

Input > .input--placeholder {
    color: $text-muted;
}

DataTable {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $background;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $panel;
}

RichLog {
    height: 1fr;
    background: $background;
    padding: 0 1;
}

#capinfo {
    height: auto;
    padding: 0 1;
}

#summary, #detail, #caveat {
    height: 1;
    padding: 0 1;
}

#why {
    height: 3;
    padding: 0 1;
}

TextScreen {
    align: center middle;
    background: #000000 70%;
}

#packets {
    height: 1fr;
}

#conditions {
    height: 9;
}

ToolsTab {
    padding: 0 1;
}

ToolsTab > Static {
    height: auto;
}

ToolsTab > .head {
    height: 1;
    padding: 0;
    margin-top: 1;
}

#coords {
    height: 1;
}

#coords Input {
    width: 20;
    margin-right: 1;
}

Sparkline {
    height: 3;
    margin-top: 1;
}

Sparkline > .sparkline--max-color {
    color: $primary;
}

Sparkline > .sparkline--min-color {
    color: $primary 30%;
}

Footer {
    background: $background;
}

Confirm, Prompt {
    align: center middle;
    background: #000000 70%;
}

.dialog {
    width: 62;
    height: auto;
    padding: 1 2;
    border: heavy $primary;
    background: $background;
}

Confirm .dialog {
    border: heavy $error;
}

.dialog-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

Confirm .dialog-title {
    color: $error;
}

.dialog-buttons {
    height: 1;
    align-horizontal: right;
}

Button {
    border: none;
    height: 1;
    min-width: 8;
    margin-left: 1;
    background: #1c1c19;
    color: $foreground;
}

Button:focus {
    background: $primary;
    color: #000000;
    text-style: bold;
}

Button#yes:focus {
    background: $error;
}

Toast {
    background: $background;
    border-left: heavy $primary;
}

Toast.-error {
    border-left: heavy $error;
}

Toast.-warning {
    border-left: heavy $error;
}
